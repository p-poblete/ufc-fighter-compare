---
import "@fontsource-variable/inter";
import "@fontsource-variable/archivo/wdth.css";
import "../styles/app.css";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { repoUrl } from "../config";
import type { Meta } from "../lib/data";
import { dateLong } from "../lib/format";

interface Props {
  title: string;
  description: string;
  glow?: "pair" | "solo" | "none";
  /** Profile accent: the fighter's archetype (Striker, Grappler, Balanced) or "none" for the neutral grey default. */
  accent?: string;
}
const { title, description, glow = "pair", accent } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const nav = [
  { href: "/", label: "Compare", on: path === "/" },
  { href: "/fighters/", label: "Fighters", on: path.startsWith("/fighters") },
  { href: "/groups/", label: "Groups", on: path.startsWith("/groups") },
  { href: "/method/", label: "Method", on: path.startsWith("/method") },
];
const icon = (d: string) => `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const meta: Meta = JSON.parse(await readFile(join(process.cwd(), "public/data/meta.json"), "utf-8"));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />
    <title>{title.trim()}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="HxmUbJGwlTO9XBwQZG-pj7jFfjrnyTN75m-TL2pSCR4" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UFC Fighter Compare" />
    <meta property="og:title" content={title.trim()} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title.trim()} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body data-glow={glow} data-accent={accent}>
    <header class="topbar">
      <div class="wide topbar__in">
        <a class="brand" href="/" aria-label="Fighter Compare, home">
          <svg class="brand__mark" viewBox="0 0 256 256" aria-hidden="true">
            <path fill="#e5484d" d="M197.42 45.86L172.39 20.83H83.61L20.83 83.61V172.39L45.86 197.42Z" /><path fill="#3e8cf0" d="M235.17 83.61L210.14 58.58L58.58 210.14L83.61 235.17H172.39L235.17 172.39Z" />
          </svg>
          <span>Fighter Compare</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {nav.map((n) => <a href={n.href} aria-current={n.on ? "page" : undefined}>{n.label}</a>)}
          <a href={repoUrl} class="nav__ext">Source <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="tools" role="toolbar" aria-label="Tools">
          <button type="button" class="tool tool--search" id="t-search" aria-label="Quick search (Ctrl+K)"><Fragment set:html={icon("M9 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zm4.5-1.5L17 17")} /><span>Search any fighter…</span><kbd>Ctrl K</kbd></button>
          <slot name="tools" />
          <div class="tool-wrap">
            <button type="button" class="tool" id="t-recent" aria-expanded="false" aria-controls="m-recent" title="Recent comparisons"><Fragment set:html={icon("M10 5v5l3 2M3.5 10a6.5 6.5 0 1 0 2-4.7M3 3v3h3")} /><span class="sr">Recent comparisons</span></button>
            <div class="menu" id="m-recent" hidden></div>
          </div>
          <button type="button" class="tool" id="t-share" title="Share"><Fragment set:html={icon("M10 3v10M6 7l4-4 4 4M4 12v4h12v-4")} /><span class="sr">Share</span></button>
          <button type="button" class="tool" id="t-export" title="Export image"><Fragment set:html={icon("M3 5h14v10H3zM7 9a1 1 0 1 0 0-.1M3 14l4-4 3 3 3-2 4 3")} /><span class="sr">Export image</span></button>
          <div class="tool-wrap">
            <button type="button" class="tool" id="t-view" aria-expanded="false" aria-controls="m-view" title="View settings"><Fragment set:html={icon("M4 6h8M15 6h1M4 14h1M8 14h8M12 4v4M6 12v4")} /><span class="sr">View settings</span></button>
            <div class="menu menu--view" id="m-view" hidden>
              <p class="menu__title">Units</p>
              <div class="seg"><button type="button" data-units="metric" aria-pressed="true">Metric</button><button type="button" data-units="imperial" aria-pressed="false">Imperial</button></div>
              <p class="menu__title">Percentiles compared with</p>
              <div class="seg"><button type="button" data-base="auto" aria-pressed="true">Auto</button><button type="button" data-base="division" aria-pressed="false">Division</button><button type="button" data-base="global" aria-pressed="false">All fighters</button></div>
              <p class="menu__empty">Auto uses the shared division when both fight in it.</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <slot />

    <footer class="wide footer">
      <p>
        Data through <time datetime={meta.data_through}>{dateLong(meta.data_through)}</time> ·
        {meta.fights.toLocaleString("en-US")} UFC fights since 2010 · {meta.fighters.toLocaleString("en-US")} fighters.
      </p>
      <p>
        Sources:{" "}
        {meta.sources.map((s, i) => (
          <>
            <a href={s.url}>{s.name}</a> ({s.license}){i < meta.sources.length - 1 ? "; " : "."}
          </>
        ))}{" "}
        Odds fallback by Matt Dabbert, CC BY 4.0. Code under MIT on <a href={repoUrl}>GitHub</a>. Not affiliated with the UFC.
      </p>
    </footer>
  </body>
</html>

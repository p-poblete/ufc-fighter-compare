---
// One static profile per fighter in index.json, built from the same modules as the comparison.
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import type { Fighter, IndexEntry } from "../../lib/data";
import { finishRate, finishes, fightRows, history, identity, pctText, record, style, winRate } from "../../lib/render";

export async function getStaticPaths() {
  const index: IndexEntry[] = JSON.parse(await readFile(join(process.cwd(), "public/data/index.json"), "utf-8"));
  return index.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const f: Fighter = JSON.parse(await readFile(join(process.cwd(), "public/data/fighters", `${slug}.json`), "utf-8"));
const desc = `${f.name}: ${f.record.wins}-${f.record.losses}-${f.record.draws}${f.weight_class ? `, ${f.weight_class}` : ""}. Style, finishes, betting returns and every UFC fight since 2010.`;
---

<Base title={`${f.name} · UFC Fighter Compare`} description={desc} glow="solo">
  <nav slot="bar" class="bar bar--solo" aria-label="Profile actions">
    <a class="cta" href={`/?a=${f.slug}`}>Compare {f.name} with another fighter</a>
  </nav>

  <main class="wide profile" id="profile" data-slug={f.slug}>
    <h1 class="sr">{f.name}</h1>
    <aside class="col col--solo">
      <Fragment set:html={identity(f, "solo", null, true) + record(f, "solo")} />
      <section class="panel kpis" data-module="profile.rates" aria-label="Rates">
        <div><p class="display">{pctText(winRate(f))}</p><p class="muted">Win rate</p></div>
        <div><p class="display">{pctText(finishRate(f))}</p><p class="muted">Finish rate in the UFC</p></div>
      </section>
      <Fragment set:html={finishes(f, "solo") + history(f, 8, "solo")} />
    </aside>
    <div class="col col--mid">
      <Fragment set:html={style(f, null) + fightRows(true)} />
    </div>
  </main>

  <script>
    import { loadFighter } from "../../lib/data";
    import { setupFightDialog } from "../../lib/dialog";
    setupFightDialog();
    const root = document.getElementById("profile")!;
    loadFighter(root.dataset.slug!).then(async (f) => {
      const { drawCharts } = await import("../../lib/charts");
      drawCharts(root.querySelector(".col--mid")!, [{ f, color: "#ff9f43" }], ["solo"]);
    });
  </script>
</Base>

---
// Design lab D (not linked): dense dashboard with fixed compare bar, framed photos, real data.
import "@fontsource-variable/inter";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { featured } from "../config";
import type { Fighter } from "../lib/data";
import { ageFrom, feetInches } from "../lib/format";

type Full = Fighter & {
  wins_by: Record<string, number>;
  losses_by: Record<string, number>;
  odds: { total: { roi_pct: number | null; n: number } };
  duration: { avg_minutes: number; decision_pct: number };
};
const read = async (slug: string): Promise<Full> =>
  JSON.parse(await readFile(join(process.cwd(), "public/data/fighters", `${slug}.json`), "utf-8"));
const a = await read(featured.a);
const b = await read(featured.b);
const rec = (f: Fighter) => `${f.record.wins}-${f.record.losses}-${f.record.draws}`;
const age = (f: Fighter) => (f.dob ? ageFrom(f.dob) : f.age);
const photo = {
  a: { src: "/lab/a.png", pos: "62% 18%", credit: "Новости ННТ, CC BY 3.0" },
  b: { src: "/lab/b.jpg", pos: "50% 6%", credit: "The White House, public domain" },
};
const tape = [
  { l: "Age", a: age(a), b: age(b), n: true },
  { l: "Height", a: `${Math.round(a.height_cm!)} cm`, b: `${Math.round(b.height_cm!)} cm`, sa: feetInches(a.height_cm!), sb: feetInches(b.height_cm!) },
  { l: "Reach", a: `${Math.round(a.reach_cm!)} cm`, b: `${Math.round(b.reach_cm!)} cm`, sa: `${Math.round(a.reach_cm! / 2.54)}″`, sb: `${Math.round(b.reach_cm! / 2.54)}″` },
  { l: "Weight", a: `${a.weight_lbs} lb`, b: `${b.weight_lbs} lb` },
  { l: "Stance", a: a.stance, b: b.stance },
  { l: "UFC record", a: `${a.ufc_record.W}-${a.ufc_record.L}-${a.ufc_record.D}`, b: `${b.ufc_record.W}-${b.ufc_record.L}-${b.ufc_record.D}` },
  { l: "Avg. fight", a: `${a.duration.avg_minutes.toFixed(1)} min`, b: `${b.duration.avg_minutes.toFixed(1)} min` },
  { l: "Betting ROI", a: a.odds.total.roi_pct == null ? "—" : `${a.odds.total.roi_pct > 0 ? "+" : ""}${a.odds.total.roi_pct.toFixed(0)}%`, b: b.odds.total.roi_pct == null ? "—" : `${b.odds.total.roi_pct > 0 ? "+" : ""}${b.odds.total.roi_pct.toFixed(0)}%` },
];
const methods = [["KO/TKO", "KO/TKO"], ["Submission", "SUB"], ["Decision", "DEC"]] as const;
const maxRec = Math.max(a.record.wins, b.record.wins);
const maxWin = Math.max(...methods.flatMap(([, k]) => [a.wins_by[k], b.wins_by[k]]));
const maxLoss = Math.max(1, ...methods.flatMap(([, k]) => [a.losses_by[k], b.losses_by[k]]));
const sides = [
  { f: a, s: "a", corner: "Red corner" },
  { f: b, s: "b", corner: "Blue corner" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lab D · dashboard</title>
    <style is:global>
      :root {
        --ground: #0b0c0e; --s1: #141518; --s2: #1c1e22; --s3: #26292e;
        --text: #f4f5f6; --muted: #a3a6ad; --faint: #73767e;
        --red: #e5484d; --blue: #3e8cf0;
        --font: "Inter Variable", system-ui, sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ground); color: var(--text); font: 400 14px/1.45 var(--font); font-variant-numeric: tabular-nums; }
      h1, h2, h3, p { margin: 0; }
      .col { width: min(100% - 32px, 1280px); margin-inline: auto; }

      /* Fixed compare bar */
      .top { position: sticky; top: 0; z-index: 5; background: var(--ground); }
      .top .col { display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: center; height: 68px; }
      .brand { font-weight: 700; letter-spacing: -0.02em; font-size: 15px; }
      .bar { display: grid; grid-template-columns: 1fr 40px 1fr; gap: 6px; max-width: 820px; width: 100%; justify-self: center; }
      .pick { height: 44px; border-radius: 12px; background: var(--s1); display: flex; align-items: center; gap: 10px; padding: 0 8px 0 14px; }
      .pick i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }
      .pick.a { --c: var(--red); } .pick.b { --c: var(--blue); }
      .pick span { font-weight: 600; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .pick .f { height: 30px; padding: 0 10px; border-radius: 8px; background: var(--s2); color: var(--muted); font-size: 12px; display: grid; place-items: center; white-space: nowrap; }
      .swap { height: 44px; border-radius: 12px; border: 0; background: var(--s1); color: var(--text); font-size: 16px; cursor: pointer; }
      .src { color: var(--muted); }

      main { padding-block: 8px 48px; display: grid; gap: 12px; }
      .titlerow { display: flex; justify-content: space-between; align-items: baseline; padding: 4px 2px 8px; }
      h1 { font-size: 22px; font-weight: 650; letter-spacing: -0.02em; }
      .stamp { color: var(--faint); font-size: 13px; }

      /* Row 1: corner | tape | corner */
      .r1 { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 3fr); gap: 12px; }
      .panel { background: var(--s1); border-radius: 18px; padding: 18px; }
      .corner { display: grid; grid-template-columns: 132px 1fr; gap: 16px; align-items: stretch; }
      .corner.b { grid-template-columns: 1fr 132px; text-align: right; }
      .corner.b .frame { order: 2; }
      .corner.a { --c: var(--red); } .corner.b { --c: var(--blue); }
      .frame { border-radius: 14px; padding: 2px; background: linear-gradient(to top, var(--c), color-mix(in srgb, var(--c) 0%, transparent) 75%); }
      .frame > div { height: 100%; min-height: 168px; border-radius: 12px; overflow: hidden; background: radial-gradient(70% 60% at 50% 85%, color-mix(in srgb, var(--c) 28%, var(--s2)), var(--s2)); }
      .frame img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08) brightness(0.92); mix-blend-mode: luminosity; display: block; }
      .who { display: grid; align-content: space-between; gap: 10px; min-width: 0; }
      .cl { color: var(--c); font-size: 12px; font-weight: 600; filter: brightness(1.25); }
      .who h2 { font-size: 24px; line-height: 1.05; font-weight: 700; letter-spacing: -0.025em; }
      .who .sub { color: var(--muted); margin-top: 4px; }
      .rec { font-size: 34px; line-height: 1; font-weight: 700; letter-spacing: -0.03em; }
      .rec small { display: block; font-size: 12px; color: var(--faint); font-weight: 500; letter-spacing: 0; margin-top: 4px; }
      .chip { display: inline-block; padding: 3px 9px; border-radius: 999px; background: var(--s3); color: var(--text); font-size: 12px; font-weight: 600; }

      .tape { padding: 10px 18px; }
      .tape .row { display: grid; grid-template-columns: 1fr 104px 1fr; padding: 7px 0; align-items: baseline; }
      .tape .row + .row { box-shadow: 0 -1px 0 var(--s2); }
      .tape .v { font-weight: 600; }
      .tape .v.a { text-align: right; } .tape .v.b { text-align: left; }
      .tape .v small { color: var(--faint); font-weight: 400; font-size: 12px; margin-inline: 6px; }
      .tape .l { text-align: center; color: var(--faint); font-size: 12px; }

      /* Row 2: three mirrored bar panels */
      .r2 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
      .r2 h3 { font-size: 14px; font-weight: 600; margin-bottom: 12px; display: flex; justify-content: space-between; }
      .r2 h3 span { color: var(--faint); font-weight: 400; font-size: 12px; }
      .m { display: grid; grid-template-columns: 1fr 86px 1fr; align-items: center; padding: 5px 0; }
      .m .l { text-align: center; color: var(--muted); font-size: 12px; }
      .m .x { display: flex; align-items: center; gap: 8px; }
      .m .x.a { flex-direction: row-reverse; }
      .m .x i { height: 14px; border-radius: 3px; min-width: 2px; }
      .m .x.a i { background: var(--red); } .m .x.b i { background: var(--blue); }
      .m .x b { font-weight: 600; min-width: 2ch; font-size: 13px; }
      .m .x.a b { text-align: right; }
      .next { color: var(--faint); font-size: 12px; margin-top: 8px; }
      .credit { color: var(--faint); font-size: 12px; padding-top: 6px; }

      @media (max-width: 1100px) {
        .r1 { grid-template-columns: 1fr 1fr; }
        .tape { grid-column: 1 / -1; order: 3; }
        .r2 { grid-template-columns: 1fr; }
      }
      @media (max-width: 720px) {
        .top .col { grid-template-columns: 1fr; height: auto; padding-block: 10px; gap: 8px; }
        .src { display: none; }
        .bar { grid-template-columns: 1fr; }
        .swap { height: 32px; }
        .r1 { grid-template-columns: 1fr; }
        .corner, .corner.b { grid-template-columns: 104px 1fr; text-align: left; }
        .corner.b .frame { order: 0; }
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="col">
        <div class="brand">Fighter Compare</div>
        <div class="bar">
          <div class="pick a"><i></i><span>{a.name}</span><div class="f">All divisions ▾</div></div>
          <button class="swap" aria-label="Swap corners">⇄</button>
          <div class="pick b"><i></i><span>{b.name}</span><div class="f">All divisions ▾</div></div>
        </div>
        <a class="src">Source</a>
      </div>
    </header>

    <main class="col">
      <div class="titlerow">
        <h1>{a.name} vs {b.name}</h1>
        <p class="stamp">Data through 21 November 2026</p>
      </div>

      <div class="r1">
        {sides.map(({ f, s, corner }) => (
          <>
            {s === "b" && (
              <section class="panel tape" aria-label="Tale of the tape">
                {tape.map((r) => (
                  <div class="row">
                    <span class="v a">{r.sa && <small>{r.sa}</small>}{r.a}</span>
                    <span class="l">{r.l}</span>
                    <span class="v b">{r.b}{r.sb && <small>{r.sb}</small>}</span>
                  </div>
                ))}
              </section>
            )}
            <section class={`panel corner ${s}`}>
              <div class="frame"><div><img src={photo[s].src} alt={f.name} style={`object-position:${photo[s].pos}`} /></div></div>
              <div class="who">
                <div>
                  <p class="cl">{corner}</p>
                  <h2>{f.name}</h2>
                  <p class="sub">{[f.nickname && `“${f.nickname}”`, f.weight_class].filter(Boolean).join(" · ")}</p>
                </div>
                <div><span class="chip">{f.archetype}</span></div>
                <p class="rec">{rec(f)}<small>Professional record</small></p>
              </div>
            </section>
          </>
        ))}
      </div>

      <div class="r2">
        <section class="panel">
          <h3>Record <span>whole career</span></h3>
          {([["Wins", "wins"], ["Losses", "losses"], ["Draws", "draws"]] as const).map(([l, k]) => (
            <div class="m">
              <div class="x a"><i style={`width:${(a.record[k] / maxRec) * 80}%`}></i><b>{a.record[k]}</b></div>
              <span class="l">{l}</span>
              <div class="x b"><i style={`width:${(b.record[k] / maxRec) * 80}%`}></i><b>{b.record[k]}</b></div>
            </div>
          ))}
        </section>
        <section class="panel">
          <h3>How they win <span>UFC since 2010</span></h3>
          {methods.map(([l, k]) => (
            <div class="m">
              <div class="x a"><i style={`width:${(a.wins_by[k] / maxWin) * 80}%`}></i><b>{a.wins_by[k]}</b></div>
              <span class="l">{l}</span>
              <div class="x b"><i style={`width:${(b.wins_by[k] / maxWin) * 80}%`}></i><b>{b.wins_by[k]}</b></div>
            </div>
          ))}
        </section>
        <section class="panel">
          <h3>How they lose <span>UFC since 2010</span></h3>
          {methods.map(([l, k]) => (
            <div class="m">
              <div class="x a"><i style={`width:${(a.losses_by[k] / maxLoss) * 80}%`}></i><b>{a.losses_by[k]}</b></div>
              <span class="l">{l}</span>
              <div class="x b"><i style={`width:${(b.losses_by[k] / maxLoss) * 80}%`}></i><b>{b.losses_by[k]}</b></div>
            </div>
          ))}
          <p class="next">Next rows: style radar, fight history, odds (cuts 3–5).</p>
        </section>
      </div>
      <p class="credit">Photos: {photo.a.credit}; {photo.b.credit}. Wikimedia Commons.</p>
    </main>
  </body>
</html>

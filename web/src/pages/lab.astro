---
// Design lab (not linked, not final): three alternatives for the first section, with real data.
import "@fontsource-variable/inter";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { featured } from "../config";
import type { Fighter } from "../lib/data";
import { ageFrom, feetInches } from "../lib/format";

const read = async (slug: string): Promise<Fighter> =>
  JSON.parse(await readFile(join(process.cwd(), "public/data/fighters", `${slug}.json`), "utf-8"));
const a = await read(featured.a);
const b = await read(featured.b);
const rec = (f: Fighter) => `${f.record.wins}-${f.record.losses}-${f.record.draws}`;
const age = (f: Fighter) => (f.dob ? ageFrom(f.dob) : f.age);
const blurb: Record<string, string> = {
  Grappler: "Wins on the mat: takedowns and control above most of the division.",
  Striker: "Wins on the feet: lands more significant strikes than most of the division.",
  Balanced: "Threat on the feet and on the mat.",
};
const pair = [
  { f: a, side: "a" },
  { f: b, side: "b" },
] as const;
const quick = [
  { label: "Age", fa: String(age(a)), fb: String(age(b)) },
  { label: "Height", fa: `${Math.round(a.height_cm!)} cm`, fb: `${Math.round(b.height_cm!)} cm` },
  { label: "Reach", fa: `${Math.round(a.reach_cm!)} cm`, fb: `${Math.round(b.reach_cm!)} cm` },
  { label: "Stance", fa: a.stance!, fb: b.stance! },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lab · first section</title>
    <style is:global>
      :root {
        --red: #e5484d; --blue: #3e8cf0;
        --font: "Inter Variable", system-ui, sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: #0b0c0e; color: #fff; font: 400 15px/1.5 var(--font); font-variant-numeric: tabular-nums; }
      .label { width: min(100% - 32px, 1120px); margin: 56px auto 16px; color: #9a9ca3; font-size: 14px; }
      .label b { color: #fff; font-size: 20px; display: block; margin-bottom: 2px; }
      .wrap { width: min(100% - 32px, 1120px); margin-inline: auto; }
      .sil { display: block; width: 100%; height: 100%; }
      .ghost { background: none; border: 0; color: #9a9ca3; font: 500 13px var(--font); cursor: pointer; padding: 4px 0; text-decoration: underline; text-underline-offset: 3px; }
      .ghost:hover { color: #fff; }

      /* A · Face-off */
      .A { background: #141518; border-radius: 20px; padding: 32px 32px 24px; }
      .A .row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; }
      .A .side { display: grid; gap: 14px; justify-items: start; }
      .A .side.b { text-align: right; justify-items: end; }
      .A .portrait { width: 200px; aspect-ratio: 1; border-radius: 16px; background: #1d1f23; overflow: hidden; position: relative; }
      .A .portrait::after { content: ""; position: absolute; inset: auto 0 0; height: 3px; background: var(--c); }
      .A .side.a { --c: var(--red); } .A .side.b { --c: var(--blue); }
      .A .portrait.b-flip .sil { transform: scaleX(-1); }
      .A .name { font-size: 40px; line-height: 1.02; font-weight: 700; letter-spacing: -0.03em; margin: 0; }
      .A .meta { color: #9a9ca3; }
      .A .rec { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
      .A .vs { text-align: center; color: #5e6168; font-weight: 600; font-size: 14px; padding-bottom: 54px; }
      .A .quick { margin-top: 28px; display: grid; grid-template-columns: repeat(4, 1fr); background: #0f1012; border-radius: 12px; }
      .A .quick div { padding: 12px 16px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: baseline; }
      .A .quick span:first-child { text-align: right; font-weight: 600; }
      .A .quick span:nth-child(2) { color: #6f727a; font-size: 12px; }
      .A .quick span:last-child { font-weight: 600; }

      /* B · Compare bar */
      .B .bar { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; background: #141518; border-radius: 999px; padding: 6px; }
      .B .pick { display: flex; align-items: center; gap: 10px; padding: 0 18px; height: 48px; border-radius: 999px; background: #1d1f23; font-weight: 600; font-size: 16px; }
      .B .pick i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
      .B .pick small { color: #6f727a; font-weight: 400; margin-left: auto; }
      .B .pick.a { --c: var(--red); } .B .pick.b { --c: var(--blue); }
      .B .swap { width: 48px; height: 48px; border-radius: 50%; border: 0; background: #1d1f23; color: #fff; font-size: 18px; }
      .B .head { margin-top: 40px; display: grid; grid-template-columns: 1fr 160px 1fr; align-items: end; }
      .B .head .b { text-align: right; }
      .B .head h2 { margin: 0; font-size: 56px; line-height: 0.95; font-weight: 700; letter-spacing: -0.035em; }
      .B .head p { margin: 8px 0 0; color: #9a9ca3; }
      .B .head .c { text-align: center; color: #5e6168; font-weight: 600; }
      .B .tape { margin-top: 28px; }
      .B .tape div { display: grid; grid-template-columns: 1fr 160px 1fr; padding: 11px 0; }
      .B .tape div:nth-child(odd) { background: #111214; border-radius: 8px; }
      .B .tape span:first-child { padding-left: 16px; font-weight: 600; }
      .B .tape span:nth-child(2) { text-align: center; color: #6f727a; }
      .B .tape span:last-child { text-align: right; padding-right: 16px; font-weight: 600; }

      /* C · Cards (your screenshot) */
      .C { display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; }
      .C .card { background: #1d1f23; border-radius: 24px; padding: 28px; display: grid; gap: 18px; }
      .C .frame { aspect-ratio: 4 / 3; border-radius: 18px; padding: 3px; background: linear-gradient(to top, var(--c), transparent 70%); }
      .C .frame > div { height: 100%; border-radius: 15px; background: radial-gradient(60% 70% at 50% 60%, color-mix(in srgb, var(--c) 22%, #16171a), #16171a); overflow: hidden; display: grid; place-items: end center; }
      .C .frame .sil { width: 62%; height: auto; }
      .C .card.a { --c: var(--red); } .C .card.b { --c: var(--blue); }
      .C h2 { margin: 0; font-size: 32px; line-height: 1.05; font-weight: 700; letter-spacing: -0.025em; }
      .C .type { font-weight: 600; font-size: 17px; }
      .C .card p { margin: 0; color: #c9cbd0; }
      .C .foot { display: flex; justify-content: space-between; align-items: baseline; }
      .C .rec { font-size: 24px; font-weight: 600; }
      .C .vs { width: 56px; height: 56px; border-radius: 50%; background: #1d1f23; display: grid; place-items: center; font-weight: 700; color: #9a9ca3; }

      @media (max-width: 820px) {
        .A .row, .C { grid-template-columns: 1fr; }
        .A .side.b { text-align: left; justify-items: start; }
        .A .vs { padding: 0; text-align: left; }
        .A .quick { grid-template-columns: 1fr 1fr; }
        .B .bar { grid-template-columns: 1fr; border-radius: 24px; }
        .B .head h2 { font-size: 32px; }
        .B .head, .B .tape div { grid-template-columns: 1fr 90px 1fr; }
        .C .vs { justify-self: center; }
      }
    </style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="sil" viewBox="0 0 200 200">
        <circle cx="100" cy="74" r="34" fill="#3a3d44" />
        <path d="M100 116c-46 0-78 22-86 84h172c-8-62-40-84-86-84z" fill="#3a3d44" />
        <path d="M84 104h32v18c-6 6-26 6-32 0z" fill="#3a3d44" />
      </symbol>
    </svg>

    <p class="label"><b>A · Face-off</b> Like a broadcast tale of the tape: portraits facing each other, big names and records, four quick facts under them. Change a fighter from the name. Corner colour only as a thin line under each portrait.</p>
    <section class="wrap A">
      <div class="row">
        {pair.map(({ f, side }) => (
          <>
            {side === "b" && <div class="vs">VS<br /><span style="font-weight:400">{a.weight_class === b.weight_class ? a.weight_class : "Catch fight"}</span></div>}
            <div class={`side ${side}`}>
              <div class={`portrait ${side === "b" ? "b-flip" : ""}`}><svg class="sil"><use href="#sil" /></svg></div>
              <div>
                <h2 class="name">{f.name}</h2>
                <div class="meta">{[f.nickname && `“${f.nickname}”`, f.weight_class].filter(Boolean).join(" · ")}</div>
              </div>
              <div class="rec">{rec(f)}</div>
              <button class="ghost">Change fighter</button>
            </div>
          </>
        ))}
      </div>
      <div class="quick">{quick.map((q) => <div><span>{q.fa}</span><span>{q.label}</span><span>{q.fb}</span></div>)}</div>
    </section>

    <p class="label"><b>B · Compare bar</b> Like stat sites: one search bar holds both picks and the swap; under it, the names in very large type and the tale of the tape straight away. The most data, the least decoration; no pictures.</p>
    <section class="wrap B">
      <div class="bar">
        <div class="pick a"><i></i>{a.name}<small>{rec(a)}</small></div>
        <button class="swap" aria-label="Swap corners">⇄</button>
        <div class="pick b"><i></i>{b.name}<small>{rec(b)}</small></div>
      </div>
      <div class="head">
        <div><h2>{a.name.split(" ").slice(-1)}</h2><p>{a.weight_class} · {rec(a)}</p></div>
        <div class="c">vs</div>
        <div class="b"><h2>{b.name.split(" ").slice(-1)}</h2><p>{b.weight_class} · {rec(b)}</p></div>
      </div>
      <div class="tape">
        {quick.map((q) => <div><span>{q.fa}</span><span>{q.label}</span><span>{q.fb}</span></div>)}
        <div><span>{a.weight_lbs} lb</span><span>Weight</span><span>{b.weight_lbs} lb</span></div>
        <div><span>{feetInches(a.height_cm!)}</span><span>Height (ft)</span><span>{feetInches(b.height_cm!)}</span></div>
      </div>
    </section>

    <p class="label"><b>C · Fighter cards</b> From your screenshot: two rounded cards on charcoal, a portrait frame whose border rises from the corner colour, the style (Grappler / Striker) as the card's message, record at the foot. Warmest and most visual; the archetype arrives early (cut 3 data).</p>
    <section class="wrap C">
      {pair.map(({ f, side }) => (
        <>
          {side === "b" && <div class="vs">VS</div>}
          <article class={`card ${side}`}>
            <div class="frame"><div><svg class="sil" viewBox="0 0 200 200"><use href="#sil" /></svg></div></div>
            <div>
              <h2>{f.name}</h2>
              <div style="color:#9a9ca3">{[f.nickname && `“${f.nickname}”`, f.weight_class].filter(Boolean).join(" · ")}</div>
            </div>
            <div><div class="type">{f.archetype}</div><p>{blurb[f.archetype ?? "Balanced"]}</p></div>
            <div class="foot"><span class="rec">{rec(f)}</span><button class="ghost">Change</button></div>
          </article>
        </>
      ))}
    </section>
    <div style="height:80px"></div>
  </body>
</html>

---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import { featured } from "../config";
import type { Fighter, IndexEntry } from "../lib/data";
import { centre, fightCharts, ownColumn, title } from "../lib/render";

const read = async <T,>(path: string): Promise<T> =>
  JSON.parse(await readFile(join(process.cwd(), "public/data", path), "utf-8"));

const index = await read<IndexEntry[]>("index.json");
const slugs = new Set(index.map((e) => e.slug));
for (const slug of [featured.a, featured.b]) {
  if (!slugs.has(slug)) throw new Error(`config.ts: featured slug "${slug}" is not in index.json`);
}
const a = await read<Fighter>(`fighters/${featured.a}.json`);
const b = await read<Fighter>(`fighters/${featured.b}.json`);

const ORDER = [
  "Strawweight", "Flyweight", "Bantamweight", "Featherweight", "Lightweight",
  "Welterweight", "Middleweight", "Light Heavyweight", "Heavyweight", "Catch Weight",
];
const rank = (d: string) => ORDER.indexOf(d.replace("Women's ", "")) + 1 || 99;
const all = [...new Set(index.map((e) => e.weight_class).filter((d): d is string => !!d))];
const men = all.filter((d) => !d.startsWith("Women's")).sort((x, y) => rank(x) - rank(y));
const women = all.filter((d) => d.startsWith("Women's")).sort((x, y) => rank(x) - rank(y));
const corners = [
  { side: "a", label: "Red corner", f: a },
  { side: "b", label: "Blue corner", f: b },
] as const;
---

<Base title={`${title(a, b)} · UFC Fighter Compare`} description="Compare two UFC fighters side by side: tale of the tape, style, record, methods, betting and fight history.">
  <link slot="head" rel="preload" href="/data/index.json" as="fetch" crossorigin="anonymous" />
  <div slot="bar" class="bar">
    {corners.map(({ side, label, f }) => (
      <div class="pick" data-side={side}>
        <i class="pick__dot" aria-hidden="true"></i>
        <div class="combo">
          <label for={`q-${side}`} class="sr">{label}: search a fighter</label>
          <input
            id={`q-${side}`}
            class="combo__input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`lb-${side}`}
            autocomplete="off"
            spellcheck="false"
            placeholder={f.name}
          />
          <ul id={`lb-${side}`} class="combo__list" role="listbox" aria-label={`${label} suggestions`} hidden></ul>
        </div>
        <select class="pick__filter" aria-label={`${label}: filter suggestions`}>
          <option value="">All</option>
          <option value="g:M">Men</option>
          <option value="g:F">Women</option>
          <optgroup label="Men's divisions">{men.map((d) => <option value={d}>{d}</option>)}</optgroup>
          <optgroup label="Women's divisions">{women.map((d) => <option value={d}>{d.replace("Women's ", "")}</option>)}</optgroup>
        </select>
      </div>
    ))}
    <button id="swap" class="swap" type="button" aria-label="Swap corners" title="Swap corners">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h12l-4-4M17 17H5l4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>

  <main class="wide dash" id="app" data-featured-a={featured.a} data-featured-b={featured.b}>
    <h1 id="title" class="sr">{title(a, b)}</h1>
    <aside class="col col--a" id="col-a" aria-label="Red corner"><Fragment set:html={ownColumn(a, "a", null, b)} /></aside>
    <div class="col col--mid" id="centre"><Fragment set:html={centre(a, b)} /></div>
    <aside class="col col--b" id="col-b" aria-label="Blue corner"><Fragment set:html={ownColumn(b, "b", null, a)} /></aside>
    <div class="fightrow" id="fights"><Fragment set:html={fightCharts(a, b)} /></div>
    <p id="live" class="sr" aria-live="polite"></p>
  </main>

  <script>
    import { boot } from "../lib/app";
    boot();
  </script>
</Base>
